{
	"name": "react-githubpages3",
	"version": "0.0.7",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "react-router build",
		"dev": "react-router dev",
		"start": "react-router-serve ./build/server/index.js",
		"preview": "pnpx http-server -c 1 -p 4173 ./build/client",
		"preview2": "pnpx http-server -c 1 -p 4173 ./build",
		"typecheck": "react-router typegen && tsc",
		"preinstall": "pnpm audit",
		"format": "oxfmt",
		"lint": "oxlint",
		"check": "oxfmt && oxlint --fix"
	},
	"dependencies": {
		"@react-router/node": "^8.4.0",
		"@react-router/serve": "^8.4.0",
		"isbot": "^5.2.2",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-router": "^8.4.0"
	},
	"devDependencies": {
		"@react-router/dev": "^8.4.0",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"react-router-devtools": "^6.2.3",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"vite": "^8.3.4"
	}
}
